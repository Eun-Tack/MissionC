# MC — 환경 변수 예시 (.env.example)
# Railway에서 이 값들을 "Variables" 탭에서 설정하세요.

# ── 필수 ────────────────────────────────────────────────────────
MC_ENV=production

# 세션 서명 키 (랜덤 문자열로 교체)
SESSION_SECRET=여기에-랜덤-문자열-입력

# Google Calendar OAuth
MC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
MC_GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Optional app login OAuth
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
ALLOWED_EMAIL=iet030507@gmail.com
APP_URL=https://your-app.railway.app

# SQLite 파일 위치 (Railway: /data 볼륨을 마운트하고 아래 경로 사용)
MC_DB_PATH=/data/mc.db

# 노트 폴더 (Railway: /data/notes 권장)
MC_NOTES_ROOT=/data/notes

# ── 선택 (연동 기능 사용 시) ─────────────────────────────────────
# GitHub PAT (repo 연동)
MC_GH_PAT=ghp_xxxxxxxxxxxx

# Telegram Bot Token
MC_TG_BOT_TOKEN=123456789:ABCDExxxxxx

# Railway PORT (자동 주입 — 직접 설정 불필요)
# PORT=8000
