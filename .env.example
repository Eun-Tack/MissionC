# MissionC local environment example
#
# For local testing:
#   1. Copy this file to .env.
#   2. Keep MC_ENV=development unless you are deploying.
#   3. Leave Google/GitHub/Telegram values blank unless you are testing integrations.

MC_ENV=development
HOST=127.0.0.1
PORT=8000

# Optional in development. In production, set a long random value.
SESSION_SECRET=missionc-local-dev-secret

# Local database and notes. Relative paths are fine for local test copies.
MC_DB_PATH=data/mc.db
MC_NOTES_ROOT=data/notes

# App URL used by OAuth callbacks. For local testing, keep this localhost URL.
APP_URL=http://127.0.0.1:8000

# Optional app login OAuth.
# Leave GOOGLE_CLIENT_ID blank to skip login during local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=

# Optional Google Calendar integration.
MC_GOOGLE_CLIENT_ID=
MC_GOOGLE_CLIENT_SECRET=

# Optional GitHub and Telegram integrations.
MC_GH_PAT=
MC_TG_BOT_TOKEN=
